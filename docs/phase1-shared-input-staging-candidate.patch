+    /// The producer is complete and input stays borrowed until this call
+    /// drains. Stream order connects the staged copy to warmup or replay.
+    unsafe fn execute_staged(&mut self, input: Ds41rtDeviceBuffer, rows: u32) -> Result<()> {
+        self.invalidate();
+        let executed = (|| unsafe {
+            self.stream.library.copy_d2d_async(self.input.buffer, input, input.bytes, self.stream.raw)?;
