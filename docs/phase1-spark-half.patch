+"""Isolated half-tile FC1 staging experiment; original FC2 and arithmetic preserved."""
+import json, statistics, torch, cutlass, cutlass.cute as cute
+from cutlass.cute.runtime import from_dlpack
+from b12x._lib.utils import current_cuda_stream
+from b12x.moe._shared.kernels.w4a8_v41_slice import V41FusedSliceKernel
+from b12x.moe._shared.kernels.w4a8_v41_pipeline import V41PipelineSliceKernel
+from tests.moe.test_v41_grouped_slices import _check_grouped_slices
+from benchmarks.benchmark_v41_grouped_slices import OrderedReduce
+state={}
+def measure(**case):
+    meta=case['meta_view'];m=case['rows'];routes=case['routes']
+    if not state:
+        for width in [64,128,192]:
+            for stages in [1,2]:
+                key=f'{width}x{stages}'
+                out=torch.empty(((576+width-1)//width,480,5120),device='cuda')
+                args=list(case['args']);args[-1]=from_dlpack(out,assumed_align=16)
+                kernel=V41FusedSliceKernel(width,grouped=True) if stages==1 else V41PipelineSliceKernel(width,grouped=True,weight_stages=stages)
+                compiled=cute.compile(kernel,*args,cutlass.Int32(80),current_cuda_stream(),meta,cutlass.Int32(64))
+                reduced=torch.empty((480,5120),device='cuda');rv=from_dlpack(reduced,assumed_align=16)
+                reducer=cute.compile(OrderedReduce((576+width-1)//width),args[-1],rv,cutlass.Int32(480),current_cuda_stream())
+                state[key]=(out,args,compiled,reduced,rv,reducer)
+                print('COMPILED',key,flush=True)
+    graphs={};checks={}
+    for key,(out,args,compiled,reduced,rv,reducer) in state.items():
+        out.fill_(12345);compiled(*args,m,current_cuda_stream(),meta,64)
+        reducer(args[-1],rv,routes,current_cuda_stream())
+        graph=torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            compiled(*args,m,current_cuda_stream(),meta,64)
+            reducer(args[-1],rv,routes,current_cuda_stream())
+        before=torch.cuda.memory_allocated();graph.replay()
+        assert before==torch.cuda.memory_allocated()
+        actual=torch.zeros_like(case['expected'])
+        actual.index_add_(0,case['pair_gpu'][:,0],reduced[:routes].bfloat16().float())
+        rel=((actual-case['expected']).norm()/case['expected'].norm()).item()
+        cosine=torch.nn.functional.cosine_similarity(actual.flatten(),case['expected'].flatten(),dim=0).item()
+        assert rel<0.01 and cosine>0.9999,(key,rel,cosine)
+        assert bool((out[:,routes:]==12345).all())
+        baseline=state[key.split('x')[0]+'x1'][0]
+        assert torch.equal(out[:,:routes],baseline[:,:routes]),(key,'changed numerical output')
+        graphs[key]=graph;checks[key]={'relative_l2':rel,'cosine':cosine,'bit_exact_same_width':True}
+    for _ in range(5):
+        for g in graphs.values():g.replay()
+    samples={k:[] for k in graphs};keys=list(graphs)
+    for iteration in range(9):
+        order=keys[iteration:]+keys[:iteration]
+        if iteration%2:order=order[::-1]
+        for key in order:
+            start,end=torch.cuda.Event(enable_timing=True),torch.cuda.Event(enable_timing=True)
+            start.record()
+            for _ in range(20):graphs[key].replay()
+            end.record();end.synchronize()
+            samples[key].append(start.elapsed_time(end)*1000/20)
+    print('TIMING '+json.dumps({'case':case['case'],'rows':m,'groups':case['groups'],'routes':routes,'checks':checks,'graph_us':samples,'median_us':{k:statistics.median(v) for k,v in samples.items()}}),flush=True)
+    for g in graphs.values():g.reset()
+if __name__=='__main__':
+    print('DEVICE',torch.cuda.get_device_properties(0),flush=True)
+    _check_grouped_slices(128,measure)
