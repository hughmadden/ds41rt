ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.05-py3
FROM ${BASE_IMAGE} AS inference

ENV DEBIAN_FRONTEND=noninteractive
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV UV_SYSTEM_PYTHON=1
ENV PATH=/opt/ds4rt/bin:${PATH}
ENV PYTHONPATH=/opt/ds4rt/third_party/sparkinfer:/opt/ds4rt/python/reference/ds4rt_reference:/opt/ds4rt/python/reference
ENV DS4RT_NATIVE_LIB=/opt/ds4rt/lib/libds4rt_native.so

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash ca-certificates curl jq tini \
      rdma-core ibverbs-providers libibverbs1 \
      libnl-3-200 libnl-route-3-200 \
      iproute2 pciutils netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir uv && \
    uv pip install --system --break-system-packages --no-cache \
      safetensors \
      huggingface-hub \
      "nvidia-cutlass-dsl[cu13]==4.6.1" \
      "apache-tvm-ffi==0.1.12" \
      "cuda-tile==1.5.0" \
      "nvidia-cudnn-frontend==1.26.0" \
      "einops==0.8.2" \
      "ninja==1.13.0" \
      "nvidia-ml-py==13.610.43" \
      "tabulate==0.10.0" \
      "transformers==5.13.0" \
      "rich==15.0.0" && \
    uv pip install --system --break-system-packages --no-cache --no-deps \
      "flashinfer-python==0.6.14" && \
    python3 -c 'import torch; print(torch.__version__)'

# The NGC 26.05 base declares pytest as a runtime requirement of its bundled
# triton-kernels distribution. Keep the release environment dependency-complete
# so the source-pinned SparkInfer installation can be checked globally below.
RUN uv pip install --system --break-system-packages --no-cache pytest

# Keep source/revision metadata after the expensive immutable dependency
# layers. Rapid SparkInfer iteration should invalidate only the pinned-source
# and release-material tail of this image.
ARG DS4RT_ROLE
ARG CUDA_ARCH
ARG DS4RT_ENGINE_COMMIT=unknown
ARG DS4RT_SPARKINFER_COMMIT=unknown
ARG DS4RT_RELEASE_VERSION=unknown

ENV DS4RT_ROLE=${DS4RT_ROLE}
ENV DS4RT_CUDA_ARCH=${CUDA_ARCH}
ENV DS4RT_ENGINE_COMMIT=${DS4RT_ENGINE_COMMIT}
ENV DS4RT_SPARKINFER_COMMIT=${DS4RT_SPARKINFER_COMMIT}
ENV DS4RT_RELEASE_VERSION=${DS4RT_RELEASE_VERSION}

LABEL org.opencontainers.image.title="DS4RT inference"
LABEL org.opencontainers.image.source="https://github.com/tpurtell/ds4rt-pro-rtx-4spark"
LABEL org.opencontainers.image.description="DeepSeek V4 Pro inference for one RTX PRO 6000 and four DGX Spark expert workers"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.revision=${DS4RT_ENGINE_COMMIT}
LABEL org.opencontainers.image.version=${DS4RT_RELEASE_VERSION}
LABEL io.ds4rt.role=${DS4RT_ROLE}
LABEL io.ds4rt.cuda_arch=${CUDA_ARCH}
LABEL io.ds4rt.sparkinfer.revision=${DS4RT_SPARKINFER_COMMIT}

COPY scripts/verify-sparkinfer-source.py /opt/ds4rt/scripts/verify-sparkinfer-source.py
COPY scripts/sparkinfer-release-provenance.py /opt/ds4rt/scripts/sparkinfer-release-provenance.py
COPY third_party/sparkinfer.lock.json /opt/ds4rt/third_party/sparkinfer.lock.json
COPY third_party/sparkinfer /opt/ds4rt/third_party/sparkinfer

RUN python3 /opt/ds4rt/scripts/verify-sparkinfer-source.py \
      --source /opt/ds4rt/third_party/sparkinfer \
      --lock /opt/ds4rt/third_party/sparkinfer.lock.json && \
    locked_revision="$(python3 /opt/ds4rt/scripts/verify-sparkinfer-source.py \
      --source /opt/ds4rt/third_party/sparkinfer \
      --lock /opt/ds4rt/third_party/sparkinfer.lock.json \
      --print-revision)" && \
    [ "${DS4RT_SPARKINFER_COMMIT}" != unknown ] && \
    [ "${DS4RT_SPARKINFER_COMMIT}" = "$locked_revision" ] && \
    uv pip install --system --break-system-packages --no-cache --no-deps \
      --editable /opt/ds4rt/third_party/sparkinfer && \
    uv pip check && \
    python3 -c 'import importlib.metadata, pathlib, b12x; source = pathlib.Path("/opt/ds4rt/third_party/sparkinfer").resolve(); module = pathlib.Path(b12x.__file__).resolve(); assert module.is_relative_to(source), (module, source); print(importlib.metadata.version("b12x"), module)' && \
    python3 /opt/ds4rt/scripts/verify-sparkinfer-source.py \
      --source /opt/ds4rt/third_party/sparkinfer \
      --lock /opt/ds4rt/third_party/sparkinfer.lock.json \
      --require-no-python-cache

COPY .ds4rt-release-image/ds4rt /opt/ds4rt/bin/ds4rt
COPY .ds4rt-release-image/libds4rt_native.so /opt/ds4rt/lib/libds4rt_native.so
COPY .ds4rt-release-image/THIRD_PARTY_NOTICES.md /opt/ds4rt/share/THIRD_PARTY_NOTICES.md
COPY .ds4rt-release-image/SPARKINFER_PROVENANCE.json /opt/ds4rt/share/SPARKINFER_PROVENANCE.json
COPY .ds4rt-release-image/SPARKINFER_LICENSE /opt/ds4rt/share/SPARKINFER_LICENSE
COPY .ds4rt-release-image/SPARKINFER_SHA256SUMS /opt/ds4rt/share/SPARKINFER_SHA256SUMS
COPY .ds4rt-release-image/XGRAMMAR_PROVENANCE.json /opt/ds4rt/share/XGRAMMAR_PROVENANCE.json
COPY .ds4rt-release-image/XGRAMMAR_LICENSE /opt/ds4rt/share/XGRAMMAR_LICENSE
COPY .ds4rt-release-image/XGRAMMAR_SHA256SUMS /opt/ds4rt/share/XGRAMMAR_SHA256SUMS
COPY python /opt/ds4rt/python
COPY scripts/real-full-tcp-serve.sh /opt/ds4rt/scripts/real-full-tcp-serve.sh
COPY scripts/kernel-cache-identity.py /opt/ds4rt/scripts/kernel-cache-identity.py
COPY docker/release-entrypoint.sh /usr/local/bin/ds4rt-release-entrypoint

RUN cmp -s \
      /opt/ds4rt/third_party/sparkinfer/LICENSE \
      /opt/ds4rt/share/SPARKINFER_LICENSE && \
    (cd /opt/ds4rt/share && sha256sum -c SPARKINFER_SHA256SUMS) && \
    (cd /opt/ds4rt/share && sha256sum -c XGRAMMAR_SHA256SUMS) && \
    python3 /opt/ds4rt/scripts/sparkinfer-release-provenance.py \
      --source /opt/ds4rt/third_party/sparkinfer \
      --lock /opt/ds4rt/third_party/sparkinfer.lock.json \
      --license /opt/ds4rt/share/SPARKINFER_LICENSE \
      --notices /opt/ds4rt/share/THIRD_PARTY_NOTICES.md \
      --verify /opt/ds4rt/share/SPARKINFER_PROVENANCE.json && \
    install -D -m 0644 \
      /opt/ds4rt/share/SPARKINFER_LICENSE \
      /opt/ds4rt/share/licenses/sparkinfer/LICENSE && \
    install -D -m 0644 \
      /opt/ds4rt/share/XGRAMMAR_LICENSE \
      /opt/ds4rt/share/licenses/xgrammar/LICENSE && \
    chmod +x \
      /opt/ds4rt/bin/ds4rt \
      /opt/ds4rt/scripts/real-full-tcp-serve.sh \
      /usr/local/bin/ds4rt-release-entrypoint && \
    python3 -c 'import b12x_mla_capture, b12x_spark_capture, triton_kv_pack_capture, triton_mlp_capture, triton_router_capture, triton_sampling_capture'

WORKDIR /opt/ds4rt
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/ds4rt-release-entrypoint"]
CMD ["ds4rt", "--help"]
