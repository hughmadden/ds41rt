#################
# DeepSeek model #
#################

MODEL_ID=wrldsuksgo2mars/DeepSeek-V4-Pro-0813-EXL3-K2-calibrated-v1
MODEL_VARIANT=pro
MODEL_REVISION=7a63f24905223aff19212d65226be708950823ac

# The calibrated Pro K2 publication is the release model. DS4RT intentionally
# fails closed if Pro is paired with anything other than the qualified EXL3
# expert format.
EXPERT_FORMAT=exl3

# balanced uses FP8 target KV, long uses native DSV4 NVFP4, and accuracy keeps
# BF16 reduction/final-response policy with the FP8-UE8M0 physical target cache.
PROFILE=balanced
# Production admits up to four requests with dSpark enabled. Ordinary traffic
# is usually C=1; C=4 is scheduled as interleaved 2x2 waves to preserve overlap.
DSPARK=on
# Follow dSpark's confidence-scored target verification length in production.
# full remains available only as a fixed-K=5 diagnostic/benchmark control.
DSPARK_DRAFT_POLICY=adaptive

# The coordinator may use logical GPU 0 only. Pin the host device by physical
# UUID so a reboot or another CUDA consumer cannot redirect DS4RT onto GPU1.
COORDINATOR_GPU=0
# For a portable first run these are resolved from COORDINATOR_GPU. Pin both
# values from `nvidia-smi` in a site-local config once the host is selected.
COORDINATOR_GPU_UUID=
COORDINATOR_GPU_PCI_BUS_ID=
COORDINATOR_GPU_HEADROOM_GIB=8

# Optional explicit target-KV pool. The production profile normally derives a
# shared, memory-budgeted pool after reserving model and concurrent-prefill
# workspace. When set it must be a multiple of 256.
# KV_POOL_TOKENS=
# MAX_CONTEXT_TOKENS=400000
# MAX_OUTPUT_TOKENS=100000
CONCURRENCY=4
# Physical batches below this width return all four BF16 TP4 partials for
# coordinator reduction. Keep the qualified Pro crossover at 16 and retune it
# explicitly after hardware, kernel, or batching changes.
SPARK_REDUCTION_MIN_ROWS=16

####################
# SparkInfer expert #
####################

# Fail closed unless the pinned checkpoint exposes its qualified EXL3 recipe.
# Native controls must explicitly select both EXPERT_FORMAT=native and disable.
SPARKINFER_EXL3=force

##############
# Networking #
##############

ADDR=0.0.0.0:8000
EXPERT_PORT=9100

SPARK_0_HOST=ostrich
SPARK_1_HOST=dodo
SPARK_2_HOST=emu
SPARK_3_HOST=kiwi
SPARK_0_LANE_A=10.55.0.1
SPARK_1_LANE_A=10.55.0.2
SPARK_2_LANE_A=10.55.0.3
SPARK_3_LANE_A=10.55.0.4

# Optional secondary Spark-to-Spark reduction rail: set all four or none.
SPARK_0_LANE_B=10.55.0.5
SPARK_1_LANE_B=10.55.0.6
SPARK_2_LANE_B=10.55.0.7
SPARK_3_LANE_B=10.55.0.8

####################
# Build and deploy #
####################

COORDINATOR_DOCKER_DEV=ds4rt-coordinator-dev
COORDINATOR_DOCKER_INFERENCE=ghcr.io/tpurtell/ds4rt-coordinator:v1
SPARK_EXPERT_DOCKER_DEV=ds4rt-spark-expert-dev
SPARK_EXPERT_DOCKER_INFERENCE=ghcr.io/tpurtell/ds4rt-spark-expert:v1
